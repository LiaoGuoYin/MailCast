{
  "name": "mailcast",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs --migrate",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "db:init:local": "pnpm db:migrate:local",
    "db:init:remote": "pnpm db:migrate:remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --env-interface WorkerBindings --include-runtime=false --env-file .env.typegen",
    "build": "tsc -p tsconfig.web.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.12.25",
    "postal-mime": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "happy-dom": "^20.8.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "登录 MailCast 控制台的密码，8–256 位且不含空格。之后可在 Worker 的 **Settings → Variables and Secrets** 中修改。"
      },
      "DB": {
        "description": "保存邮件、路由规则和设置的 D1 数据库，保留默认即可，部署时会自动建表。"
      },
      "AI": {
        "description": "可选，用于从邮件中提取验证码；不使用该功能不会产生费用。"
      }
    }
  }
}
